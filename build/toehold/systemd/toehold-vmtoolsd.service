[Unit]
Description=VMware Tools from toehold appliance installroot
After=network-online.target toehold-vgauthd.service
Wants=network-online.target
Requires=toehold-vgauthd.service

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/opt/toehold/appliance-root/usr/lib64:/opt/toehold/appliance-root/usr/lib
ExecStart=/opt/toehold/appliance-root/usr/bin/vmtoolsd -p /opt/toehold/appliance-root/usr/lib64/open-vm-tools -c /etc/vmware-tools/tools.conf
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=300
StartLimitBurst=20

[Install]
WantedBy=multi-user.target
