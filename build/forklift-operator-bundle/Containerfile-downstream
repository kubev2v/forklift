ARG EVENT_TITLE

ARG MTV_VERSION
ARG RELEASE
ARG CHANNEL
ARG DEFAULT_CHANNEL
ARG REGISTRY
ARG OCP_VERSIONS

ARG API_IMAGE="registry.redhat.io/migration-toolkit-virtualization/mtv-api-rhel9@sha256:549cb41171696b0cea03ea5d0e256cec40780036914ad6f91b33426dd990c195"

ARG CONTROLLER_IMAGE="registry.redhat.io/migration-toolkit-virtualization/mtv-controller-rhel9@sha256:7b2d5d0fdd06939ca64c484c7a1e22b73d5b4348dc8a3442ec15065222e7a036"

ARG MUST_GATHER_IMAGE="registry.redhat.io/migration-toolkit-virtualization/mtv-must-gather-rhel9@sha256:6b0560ea7d884b775be4bc45ea3165fc2eeea7cd0d7f7b1052946bc32e895d7b"

ARG OPENSTACK_POPULATOR_IMAGE="registry.redhat.io/migration-toolkit-virtualization/mtv-openstack-populator-rhel9@sha256:09a3158bfa7e440aee1acd7f87ae5180a39e87b65d02e58390aab01a24983c27"

ARG OPERATOR_IMAGE="registry.redhat.io/migration-toolkit-virtualization/mtv-rhel9-operator@sha256:8777373ff3eb56bf29cb759e9576949b072343be20843df36a28da521279aacd"

ARG OVA_PROVIDER_SERVER_IMAGE="registry.redhat.io/migration-toolkit-virtualization/mtv-ova-provider-server-rhel9@sha256:d65bbd1e971e020b13c38956e96e5a09110e02fae208954c0de85281a517b501"

ARG OVA_PROXY_IMAGE="registry.redhat.io/migration-toolkit-virtualization/mtv-ova-proxy-rhel9@sha256:4aff9f8c6783b3255eed3b66984e7f1ceaf95bbe674f86b0096b4460eaa19438"

ARG OVIRT_POPULATOR_IMAGE="registry.redhat.io/migration-toolkit-virtualization/mtv-rhv-populator-rhel8@sha256:e0d60e8c7b12543b733e98cdf8ef6fdaebfe0dd93fdea3bc9a3ead5b82e28511"

ARG POPULATOR_CONTROLLER_IMAGE="registry.redhat.io/migration-toolkit-virtualization/mtv-populator-controller-rhel9@sha256:93c1d38d68260995ab529c0e576f97cdc24d09a97158301d207b5112793320c9"

ARG UI_PLUGIN_IMAGE="registry.redhat.io/migration-toolkit-virtualization/mtv-console-plugin-rhel9@sha256:378698910911f30441538416e0a17023c3edd9216ef7f2ec44da37ccc86c1492"

ARG CLI_DOWNLOAD_IMAGE="registry.redhat.io/migration-toolkit-virtualization/mtv-cli-download-rhel9@sha256:fc796cf4b5247e8fbf94ec0818fb7e8a1957bfedaab4d56b2542e56eddba59c4"

ARG VALIDATION_IMAGE="registry.redhat.io/migration-toolkit-virtualization/mtv-validation-rhel9@sha256:b210a77d452f3782e936205dea7a90c15736f56b4827869761125bec0878b0c0"

ARG VIRT_V2V_IMAGE="registry.redhat.io/migration-toolkit-virtualization/mtv-virt-v2v-rhel10@sha256:0b055499f4ccda50d1402cca95771b584205936d6c2d30cc812caca0a15aabe0"

ARG VIRT_V2V_IMAGE_RHEL9="registry.redhat.io/migration-toolkit-virtualization/mtv-virt-v2v-rhel9@sha256:f5eb43c78ac8676e1ea7df3b3c7f40d8d5f4a86ce80e78604abd6d06f29a0639"

ARG VSPHERE_XCOPY_VOLUME_POPULATOR_IMAGE="registry.redhat.io/migration-toolkit-virtualization/mtv-vsphere-xcopy-volume-populator-rhel9@sha256:d7691a7291c59379fc596d57c32391d46a7192182aab7a1b6320d9166d2a6cdb"

USER root

COPY --from=tools /usr/bin/envsubst /usr/bin/envsubst
COPY --from=tools /usr/bin/yq /usr/bin/yq

COPY ./operator /repo
COPY ./build/forklift-operator-bundle/images.conf /repo/images.conf
WORKDIR /repo

# Set project name to mtv-operator so operator-sdk can successfully generate resources
RUN cp PROJECT PROJECT.template && PROJECT_NAME=mtv-operator envsubst < PROJECT.template > PROJECT
RUN source ./images.conf && \
    cat .downstream_manifests \
    | envsubst \
    | operator-sdk generate bundle \
    -q \
    --overwrite \
    --extra-service-accounts forklift-controller,forklift-api,forklift-populator-controller \
    --version $MTV_VERSION \
    --channels $CHANNEL \
    --default-channel $DEFAULT_CHANNEL \
    --output-dir build

# CSV from operator-sdk does not contain `relatedImages` which causes issues in diconnected environments.
# Load relatedImages object from "operator/related_images.yaml", append it to generated CSV spec and envsubst the ENV variables for specific images
# MTV-3558
RUN yq eval -i 'load("related_images.yaml").relatedImages as $images | .spec.relatedImages = $images' build/manifests/mtv-operator.clusterserviceversion.yaml
RUN envsubst < build/manifests/mtv-operator.clusterserviceversion.yaml > temp.yaml && cp temp.yaml build/manifests/mtv-operator.clusterserviceversion.yaml
USER 1001

FROM scratch

ARG MTV_VERSION
ARG RELEASE
ARG CHANNEL
ARG DEFAULT_CHANNEL
ARG REGISTRY
ARG OCP_VERSIONS
ARG REVISION
ARG CPE

COPY --from=builder /repo/build/manifests /manifests/
COPY --from=builder /repo/build/metadata /metadata/

# These are three labels needed to control how the pipeline should handle this container image
# This first label tells the pipeline that this is a bundle image and should be
# delivered via an index image
LABEL com.redhat.delivery.operator.bundle=true

# This second label tells the pipeline which versions of OpenShift the operator supports.
# This is used to control which index images should include this operator.
LABEL com.redhat.openshift.versions=$OCP_VERSIONS

# This third label tells the pipeline that this operator should *also* be supported on OCP 4.4 and
# earlier.  It is used to control whether or not the pipeline should attempt to automatically
# backport this content into the old appregistry format and upload it to the quay.io application
# registry endpoints.
LABEL com.redhat.delivery.backport=false

# The rest of these labels are copies of the same content in annotations.yaml and are needed by OLM
LABEL operators.operatorframework.io.bundle.mediatype.v1=registry+v1
LABEL operators.operatorframework.io.bundle.manifests.v1=manifests/
LABEL operators.operatorframework.io.bundle.metadata.v1=metadata/
LABEL operators.operatorframework.io.bundle.package.v1=mtv-operator
LABEL operators.operatorframework.io.bundle.channels.v1=$CHANNEL
LABEL operators.operatorframework.io.bundle.channel.default.v1=$DEFAULT_CHANNEL

# Not sure whate these label expand to
LABEL operators.operatorframework.io.metrics.builder=operator-sdk-v1.22.0+git
LABEL operators.operatorframework.io.metrics.mediatype.v1=metrics+v1
LABEL operators.operatorframework.io.metrics.project_layout=ansible.sdk.operatorframework.io/v1
LABEL operators.operatorframework.io.test.config.v1=tests/scorecard/
LABEL operators.operatorframework.io.test.mediatype.v1=scorecard+v1

# Main labels
LABEL \
    com.redhat.component="mtv-operator-bundle-container" \
    cpe="cpe:/a:redhat:migration_toolkit_virtualization:${CPE}::el9" \
    name="${REGISTRY}/mtv-operator-bundle" \
    License="Apache License 2.0" \
    io.k8s.display-name="Migration Toolkit for Virtualization" \
    io.openshift.tags="migration" \
    io.k8s.description="Migration Toolkit for Virtualization - Operator Bundle" \
    summary="Migration Toolkit for Virtualization - Operator Bundle" \
    maintainer="Migration Toolkit for Virtualization Team <migtoolkit-virt@redhat.com>" \
    description="Migration Toolkit for Virtualization - Operator Bundle" \
    vendor="Red Hat, Inc." \
    url="https://github.com/kubev2v/forklift" \
    distribution-scope="public" \
    release=$RELEASE \
    version=$MTV_VERSION \
    revision="$REVISION"
