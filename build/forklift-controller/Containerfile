FROM registry.access.redhat.com/ubi9/go-toolset:9.8-1788409979 AS builder
USER 0
WORKDIR /app
COPY --chown=1001:0 ./ ./
ENV GOFLAGS="-mod=vendor -tags=strictfipsruntime"
ENV GOEXPERIMENT=strictfipsruntime
ENV GOCACHE=/go-build/cache
RUN --mount=type=cache,target=${GOCACHE},uid=1001 go build -buildvcs=false -ldflags="-w -s" -o manager github.com/kubev2v/forklift/cmd/forklift-controller

# The setup pod runs this image with copy-appliance-setup in place of the entry
# point, so it has to be in the image the controller runs from.
RUN --mount=type=cache,target=${GOCACHE},uid=1001 go build -buildvcs=false -ldflags="-w -s" -o copy-appliance-setup github.com/kubev2v/forklift/cmd/copy-appliance-setup

# The orchestrator runs on the copy appliance VM, not here. The controller image only
# carries it so the deploy can ship it over, so it is built unlike everything else here:
#
#   CGO_ENABLED=0  a cgo binary links against this builder's glibc, not the appliance's.
#   GOEXPERIMENT   strictfipsruntime routes crypto through OpenSSL and so needs cgo. It
#     / GOFLAGS    has to go, and "none" rather than empty because empty falls back to
#                  the toolchain's baked-in default, which is the OpenSSL backend.
#   GOARCH         the appliance is a vSphere VM, so x86-64, whatever this image targets.
RUN --mount=type=cache,target=${GOCACHE},uid=1001 \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOEXPERIMENT=none GOFLAGS="-mod=vendor" \
    go build -buildvcs=false -trimpath -ldflags="-w -s" -o nbd-orchestrator github.com/kubev2v/forklift/cmd/nbd-orchestrator

FROM registry.access.redhat.com/ubi9-minimal:9.7-1778562320
# RUN microdnf -y update && microdnf -y clean all
# Required to be able to get files from within the pod
RUN microdnf -y install tar && microdnf clean all

COPY --from=builder /app/manager /usr/local/bin/forklift-controller
COPY --from=builder /app/copy-appliance-setup /usr/local/bin/copy-appliance-setup
COPY --from=builder /app/nbd-orchestrator /usr/local/bin/nbd-orchestrator
ENTRYPOINT ["/usr/local/bin/forklift-controller"]

ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

LABEL \
        com.redhat.component="mtv-controller-container" \
        name="migration-toolkit-virtualization/mtv-controller-rhel9" \
        license="Apache License 2.0" \
        io.k8s.display-name="Migration Toolkit for Virtualization" \
        io.k8s.description="Migration Toolkit for Virtualization - Controller" \
        io.openshift.tags="migration,mtv,forklift" \
        description="Migration Toolkit for Virtualization - Controller" \
        summary="Migration Toolkit for Virtualization - Controller" \
        vendor="Red Hat, Inc." \
        maintainer="Migration Toolkit for Virtualization Team <migtoolkit-virt@redhat.com>" \
        org.opencontainers.image.revision="$GIT_COMMIT" \
        org.opencontainers.image.created="$BUILD_DATE" \
        org.opencontainers.image.source="https://github.com/kubev2v/forklift"

