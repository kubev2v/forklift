---
apiVersion: v1
kind: Service
metadata:
  name: {{ virt_validation_controller_service_name }}
  namespace: {{ app_namespace }}
  annotations:
    service.beta.openshift.io/serving-cert-secret-name: {{ virt_validation_controller_tls_secret_name }}
  labels:
    app: {{ app_name }}
    component: virt-validation-controller
spec:
  selector:
    app: {{ app_name }}
    component: virt-validation-controller
  ports:
  - name: https
    port: 8443
    targetPort: metrics
