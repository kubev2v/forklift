---
apiVersion: image.openshift.io/v1
kind: ImageStream
metadata:
  name: copy-appliance-nbd
  namespace: "{{ app_namespace }}"
spec:
  lookupPolicy:
    local: true
  tags:
    - name: latest
      from:
        kind: DockerImage
        name: "{{ copy_appliance_container_image_fqin }}"
      importPolicy:
        importMode: Legacy
        scheduled: true
      referencePolicy:
        type: Local
